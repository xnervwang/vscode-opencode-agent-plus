{
  "name": "opencode-agent-plus-ui-helper",
  "publisher": "opencode-agent-plus-tests",
  "version": "0.0.0",
  "private": true,
  "engines": { "vscode": "^1.96.0" },
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "opencodeAgentPlusTests.ordered", "title": "Stand-in: A Button With an Order", "icon": "$(git-compare)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "opencodeAgentPlusTests.ordered", "group": "navigation@97", "when": "opencodeAgentPlusTests.titleOrder" }
      ]
    }
  }
}
