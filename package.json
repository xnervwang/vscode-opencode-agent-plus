{
  "name": "opencode-agent-plus",
  "displayName": "OpenCode Agent Plus",
  "description": "Chat with OpenCode, an open-source coding agent, in VS Code editor tabs using any model provider OpenCode supports.",
  "version": "1.0.0",
  "publisher": "xnervwang",
  "icon": "images/icon.png",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "xnervwang.agent-plus"
  ],
  "agentPlus": {
    "protocol": 1
  },
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:opencodeAgentPlus.chat",
    "onView:opencodeAgentPlus.sessions"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, this extension does nothing. It starts when the workspace is trusted.",
      "restrictedConfigurations": [
        "opencodeAgentPlus.opencode.path",
        "opencodeAgentPlus.opencode.askPermissions",
        "opencodeAgentPlus.bedrock.profile",
        "opencodeAgentPlus.bedrock.region",
        "opencodeAgentPlus.opencode.environment"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeAgentPlus",
          "title": "OpenCode Agent Plus",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "opencodeAgentPlus": [
        {
          "id": "opencodeAgentPlus.sessions",
          "name": "Conversations"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeAgentPlus.newConversation",
        "title": "New Conversation",
        "category": "OpenCode Agent Plus",
        "icon": "$(add)"
      },
      {
        "command": "opencodeAgentPlus.newConversationInEditor",
        "title": "OpenCode Agent Plus: New Conversation",
        "icon": {
          "light": "images/editor-title-light.svg",
          "dark": "images/editor-title-dark.svg"
        }
      },
      {
        "command": "opencodeAgentPlus.openConversation",
        "title": "Open Conversation",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.renameConversation",
        "title": "Rename Conversation",
        "category": "OpenCode Agent Plus",
        "icon": "$(edit)"
      },
      {
        "command": "opencodeAgentPlus.forkConversation",
        "title": "Fork Conversation",
        "category": "OpenCode Agent Plus",
        "icon": "$(repo-forked)"
      },
      {
        "command": "opencodeAgentPlus.deleteConversation",
        "title": "Delete Conversation",
        "category": "OpenCode Agent Plus",
        "icon": "$(trash)"
      },
      {
        "command": "opencodeAgentPlus.chooseModel",
        "title": "Choose Model for New Conversations",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.testConnection",
        "title": "Test OpenCode Connection",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.downloadOpenCode",
        "title": "Download OpenCode 2.4.1",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.setBedrockApiKey",
        "title": "Set Amazon Bedrock API Key",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.clearBedrockApiKey",
        "title": "Clear Amazon Bedrock API Key",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.downloadPython",
        "title": "Download Python for Work Plans",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.findPython",
        "title": "Look for Python Again for Work Plans",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.findConversation",
        "title": "Find Conversation…",
        "category": "OpenCode Agent Plus",
        "icon": "$(search)"
      },
      {
        "command": "opencodeAgentPlus.clearRecentlyClosed",
        "title": "Clear Recently Closed",
        "category": "OpenCode Agent Plus",
        "icon": "$(clear-all)"
      },
      {
        "command": "opencodeAgentPlus.showMcpServers",
        "title": "Show MCP Servers",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.showLogs",
        "title": "Show Logs",
        "category": "OpenCode Agent Plus"
      },
      {
        "command": "opencodeAgentPlus.diffAllowOnce",
        "title": "Allow Once",
        "category": "OpenCode Agent Plus",
        "icon": "$(check)"
      },
      {
        "command": "opencodeAgentPlus.diffAllowInProject",
        "title": "Allow in This Project",
        "category": "OpenCode Agent Plus",
        "icon": "$(check-all)"
      },
      {
        "command": "opencodeAgentPlus.diffDeny",
        "title": "Deny",
        "category": "OpenCode Agent Plus",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeAgentPlus.newConversation",
          "when": "view == opencodeAgentPlus.sessions && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "opencodeAgentPlus.findConversation",
          "when": "view == opencodeAgentPlus.sessions && isWorkspaceTrusted",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "opencodeAgentPlus.renameConversation",
          "when": "view == opencodeAgentPlus.sessions && viewItem =~ /^opencodeAgentPlus\\.session/ && opencodeAgentPlus.canRename",
          "group": "1_edit@1"
        },
        {
          "command": "opencodeAgentPlus.forkConversation",
          "when": "view == opencodeAgentPlus.sessions && viewItem =~ /^opencodeAgentPlus\\.session/ && opencodeAgentPlus.canFork",
          "group": "1_edit@2"
        },
        {
          "command": "opencodeAgentPlus.deleteConversation",
          "when": "view == opencodeAgentPlus.sessions && viewItem == opencodeAgentPlus.session",
          "group": "9_delete@1"
        },
        {
          "command": "opencodeAgentPlus.clearRecentlyClosed",
          "when": "view == opencodeAgentPlus.sessions && viewItem == opencodeAgentPlus.group.recent",
          "group": "inline"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencodeAgentPlus.renameConversation",
          "when": "resourceScheme == opencodeagentplus-session && opencodeAgentPlus.canRename",
          "group": "1_opencodeAgentPlus@1"
        },
        {
          "command": "opencodeAgentPlus.forkConversation",
          "when": "resourceScheme == opencodeagentplus-session && opencodeAgentPlus.canFork",
          "group": "1_opencodeAgentPlus@2"
        }
      ],
      "editor/title": [
        {
          "command": "opencodeAgentPlus.diffAllowOnce",
          "when": "resourceScheme =~ /^opencodeagentplus-diff$/i && resourcePath in opencodeAgentPlus.openDiffs",
          "group": "navigation@1"
        },
        {
          "command": "opencodeAgentPlus.diffAllowInProject",
          "when": "resourceScheme =~ /^opencodeagentplus-diff$/i && resourcePath in opencodeAgentPlus.openDiffs",
          "group": "navigation@2"
        },
        {
          "command": "opencodeAgentPlus.diffDeny",
          "when": "resourceScheme =~ /^opencodeagentplus-diff$/i && resourcePath in opencodeAgentPlus.openDiffs",
          "group": "navigation@3"
        },
        {
          "command": "opencodeAgentPlus.renameConversation",
          "when": "activeCustomEditorId == opencodeAgentPlus.chat && opencodeAgentPlus.canRename",
          "group": "1_opencodeAgentPlus@1"
        },
        {
          "command": "opencodeAgentPlus.forkConversation",
          "when": "activeCustomEditorId == opencodeAgentPlus.chat && opencodeAgentPlus.canFork",
          "group": "1_opencodeAgentPlus@2"
        },
        {
          "command": "opencodeAgentPlus.newConversationInEditor",
          "when": "isWorkspaceTrusted",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "opencodeAgentPlus.newConversationInEditor",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.openConversation",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.renameConversation",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.deleteConversation",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.forkConversation",
          "when": "activeCustomEditorId == opencodeAgentPlus.chat && opencodeAgentPlus.canFork && isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.diffAllowOnce",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.diffAllowInProject",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.diffDeny",
          "when": "false"
        },
        {
          "command": "opencodeAgentPlus.newConversation",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.chooseModel",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.testConnection",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.downloadOpenCode",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.setBedrockApiKey",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.clearBedrockApiKey",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.downloadPython",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.findPython",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.findConversation",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.clearRecentlyClosed",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.showMcpServers",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "opencodeAgentPlus.showLogs",
          "when": "isWorkspaceTrusted"
        }
      ],
      "webview/context": [
        {
          "command": "opencodeAgentPlus.forkConversation",
          "when": "webviewId == 'opencodeAgentPlus.chat' && opencodeAgentPlus.canFork",
          "group": "1_opencodeAgentPlus@1"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Agent Plus",
      "properties": {
        "opencodeAgentPlus.model": {
          "type": "string",
          "default": "",
          "description": "Model for new conversations, as provider/model, such as amazon-bedrock/us.xai.grok-4.7. Leave it empty to choose one when you send your first message."
        },
        "opencodeAgentPlus.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Save edited files before a message is sent or a request is allowed, so OpenCode reads and changes what the editor shows."
        },
        "opencodeAgentPlus.opencode.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the opencode executable. If it is empty, OpenCode Agent Plus looks on PATH and in the folders OpenCode's installers use."
        },
        "opencodeAgentPlus.opencode.askPermissions": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Ask before OpenCode edits files, runs commands, fetches web pages or reads or writes files outside the project. This replaces the edit, bash (shell on OpenCode 2), webfetch and external_directory rules of your own OpenCode configuration; turn it off to keep those."
        },
        "opencodeAgentPlus.opencode.environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "machine",
          "markdownDescription": "Environment variables for the OpenCode that the extension starts, such as `{ \"OPENAI_BASE_URL\": \"https://…\" }`. The Bedrock settings below take precedence over the same names. A change restarts OpenCode."
        },
        "opencodeAgentPlus.bedrock.profile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "AWS profile for Amazon Bedrock, passed to OpenCode as AWS_PROFILE. Leave it empty to use OpenCode's own configuration and your AWS configuration."
        },
        "opencodeAgentPlus.bedrock.region": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "AWS Region for Amazon Bedrock, passed to OpenCode as AWS_REGION. Leave it empty to use OpenCode's own configuration and your AWS configuration."
        },
        "opencodeAgentPlus.workPlan": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Keep a work plan in each conversation on OpenCode 2: the plan goes with every message, and the model gets tools to change it. Used only while `#agentPlus.tokenMode#` is Custom."
        },
        "opencodeAgentPlus.planBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the conversation's work plan from Agent Plus in a bar above the input box. Click the bar to open the Work plan view."
        },
        "opencodeAgentPlus.conversationLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Turn another conversation's title or session ID in a reply into a link that opens that conversation. With Agent Plus, conversations of its other agents are linked too."
        },
        "opencodeAgentPlus.conversationBrief": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Have the model keep a short summary and status of each conversation in its plan, shown by Agent Plus when the conversation is clicked. Used only while `#agentPlus.tokenMode#` is Custom."
        },
        "opencodeAgentPlus.tellOpenCodeYourTimeZone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Tell the model your time zone when it differs from that of the machine OpenCode runs on, as it can over Remote-SSH. It is said once, and again after a compaction or when a date or the offset changes. Used only while `#agentPlus.tokenMode#` is Custom."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "opencodeAgentPlus.chat",
        "displayName": "OpenCode Agent Plus Conversation",
        "selector": [
          {
            "filenamePattern": "*.opencodeagentplus-chat"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsWelcome": [
      {
        "view": "opencodeAgentPlus.sessions",
        "contents": "No conversations yet.\n[New Conversation](command:opencodeAgentPlus.newConversation)",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "opencodeAgentPlus.sessions",
        "contents": "OpenCode Agent Plus does nothing in Restricted Mode. It starts when you trust this workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)",
        "when": "!isWorkspaceTrusted"
      }
    ],
    "keybindings": [
      {
        "command": "opencodeAgentPlus.newConversation",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "when": "activeCustomEditorId == 'opencodeAgentPlus.chat'"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xnervwang/vscode-opencode-agent-plus"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  }
}
