{
  "name": "opencode-plus",
  "displayName": "OpenCode Plus",
  "description": "A coding agent for models on Amazon Bedrock, with work plans and conversation overviews.",
  "version": "0.0.1",
  "publisher": "xnervwang",
  "icon": "images/icon.png",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "xnervwang.agent-plus"
  ],
  "agentPlus": {
    "protocol": 1
  },
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:opencodePlus.chat",
    "onView:opencodePlus.sessions"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the agent cannot read or change files or run commands."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodePlus",
          "title": "OpenCode Plus",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "opencodePlus": [
        {
          "id": "opencodePlus.sessions",
          "name": "Conversations"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodePlus.newConversation",
        "title": "New Conversation",
        "category": "OpenCode Plus",
        "icon": "$(add)"
      },
      {
        "command": "opencodePlus.openConversation",
        "title": "Open Conversation",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.renameConversation",
        "title": "Rename Conversation",
        "category": "OpenCode Plus",
        "icon": "$(edit)"
      },
      {
        "command": "opencodePlus.forkConversation",
        "title": "Fork Conversation",
        "category": "OpenCode Plus",
        "icon": "$(repo-forked)"
      },
      {
        "command": "opencodePlus.deleteConversation",
        "title": "Delete Conversation",
        "category": "OpenCode Plus",
        "icon": "$(trash)"
      },
      {
        "command": "opencodePlus.chooseModel",
        "title": "Choose Model for New Conversations",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.testConnection",
        "title": "Test OpenCode Connection",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.setBedrockApiKey",
        "title": "Set Amazon Bedrock API Key",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.clearBedrockApiKey",
        "title": "Clear Amazon Bedrock API Key",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.downloadPython",
        "title": "Download Python for Work Plans",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.findPython",
        "title": "Look for Python Again for Work Plans",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.findConversation",
        "title": "Find Conversation…",
        "category": "OpenCode Plus",
        "icon": "$(search)"
      },
      {
        "command": "opencodePlus.clearRecentlyClosed",
        "title": "Clear Recently Closed",
        "category": "OpenCode Plus",
        "icon": "$(clear-all)"
      },
      {
        "command": "opencodePlus.showMcpServers",
        "title": "Show MCP Servers",
        "category": "OpenCode Plus"
      },
      {
        "command": "opencodePlus.diffAllowOnce",
        "title": "Allow Once",
        "category": "OpenCode Plus",
        "icon": "$(check)"
      },
      {
        "command": "opencodePlus.diffAllowInProject",
        "title": "Allow in This Project",
        "category": "OpenCode Plus",
        "icon": "$(check-all)"
      },
      {
        "command": "opencodePlus.diffDeny",
        "title": "Deny",
        "category": "OpenCode Plus",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodePlus.newConversation",
          "when": "view == opencodePlus.sessions",
          "group": "navigation"
        },
        {
          "command": "opencodePlus.findConversation",
          "when": "view == opencodePlus.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "opencodePlus.renameConversation",
          "when": "view == opencodePlus.sessions && viewItem =~ /^opencodePlus\\.session/ && opencodePlus.canRename",
          "group": "1_edit@1"
        },
        {
          "command": "opencodePlus.forkConversation",
          "when": "view == opencodePlus.sessions && viewItem =~ /^opencodePlus\\.session/ && opencodePlus.canFork",
          "group": "1_edit@2"
        },
        {
          "command": "opencodePlus.deleteConversation",
          "when": "view == opencodePlus.sessions && viewItem == opencodePlus.session",
          "group": "9_delete@1"
        },
        {
          "command": "opencodePlus.clearRecentlyClosed",
          "when": "view == opencodePlus.sessions && viewItem == opencodePlus.group.recent",
          "group": "inline"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencodePlus.renameConversation",
          "when": "resourceScheme == opencodeplus-session && opencodePlus.canRename",
          "group": "1_opencodePlus@1"
        },
        {
          "command": "opencodePlus.forkConversation",
          "when": "resourceScheme == opencodeplus-session && opencodePlus.canFork",
          "group": "1_opencodePlus@2"
        }
      ],
      "editor/title": [
        {
          "command": "opencodePlus.diffAllowOnce",
          "when": "resourceScheme =~ /^opencodeplus-diff$/i && resourcePath in opencodePlus.openDiffs",
          "group": "navigation@1"
        },
        {
          "command": "opencodePlus.diffAllowInProject",
          "when": "resourceScheme =~ /^opencodeplus-diff$/i && resourcePath in opencodePlus.openDiffs",
          "group": "navigation@2"
        },
        {
          "command": "opencodePlus.diffDeny",
          "when": "resourceScheme =~ /^opencodeplus-diff$/i && resourcePath in opencodePlus.openDiffs",
          "group": "navigation@3"
        },
        {
          "command": "opencodePlus.renameConversation",
          "when": "activeCustomEditorId == opencodePlus.chat && opencodePlus.canRename",
          "group": "1_opencodePlus@1"
        },
        {
          "command": "opencodePlus.forkConversation",
          "when": "activeCustomEditorId == opencodePlus.chat && opencodePlus.canFork",
          "group": "1_opencodePlus@2"
        }
      ],
      "commandPalette": [
        {
          "command": "opencodePlus.openConversation",
          "when": "false"
        },
        {
          "command": "opencodePlus.renameConversation",
          "when": "false"
        },
        {
          "command": "opencodePlus.deleteConversation",
          "when": "false"
        },
        {
          "command": "opencodePlus.forkConversation",
          "when": "activeCustomEditorId == opencodePlus.chat && opencodePlus.canFork"
        },
        {
          "command": "opencodePlus.diffAllowOnce",
          "when": "false"
        },
        {
          "command": "opencodePlus.diffAllowInProject",
          "when": "false"
        },
        {
          "command": "opencodePlus.diffDeny",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "opencodePlus.forkConversation",
          "when": "webviewId == 'opencodePlus.chat' && opencodePlus.canFork",
          "group": "1_opencodePlus@1"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Plus",
      "properties": {
        "opencodePlus.model": {
          "type": "string",
          "default": "",
          "description": "Model for new conversations, as provider/model, such as amazon-bedrock/us.xai.grok-4.7. Empty asks before the first message."
        },
        "opencodePlus.opencode.path": {
          "type": "string",
          "default": "",
          "description": "Path to the opencode executable. Empty looks for it on PATH and where its installers put it."
        },
        "opencodePlus.opencode.askPermissions": {
          "type": "boolean",
          "default": true,
          "description": "Ask before OpenCode edits files, runs commands, fetches web pages or reads outside the project. This replaces the edit, bash, webfetch and external_directory rules of your own OpenCode configuration; turn it off to keep those."
        },
        "opencodePlus.bedrock.profile": {
          "type": "string",
          "default": "",
          "description": "AWS profile for Amazon Bedrock, given to OpenCode as AWS_PROFILE. Empty leaves it to OpenCode and your AWS configuration."
        },
        "opencodePlus.bedrock.region": {
          "type": "string",
          "default": "",
          "description": "AWS Region for Amazon Bedrock, given to OpenCode as AWS_REGION. Empty leaves it to OpenCode and your AWS configuration."
        },
        "opencodePlus.workPlan": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Keep a work plan in each conversation on OpenCode 2: the plan goes with every message, and the model gets tools to change it. Used only while `#agentPlus.tokenMode#` is Custom."
        },
        "opencodePlus.planBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a bar above the input box with where the conversation's work plan stands, from Agent Plus. Click it to open the Work plan view."
        },
        "opencodePlus.conversationLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Turn another conversation's title or session ID in a reply into a link that opens that conversation. With Agent Plus, conversations of its other agents are linked too."
        },
        "opencodePlus.conversationBrief": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Have the model keep a short summary and status of each conversation in its plan, shown by Agent Plus when the conversation is clicked. Used only while `#agentPlus.tokenMode#` is Custom."
        },
        "opencodePlus.tellOpenCodeYourTimeZone": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Tell the model the time zone you read the conversation in when it differs from that of the machine OpenCode runs on, as over Remote-SSH, so it gives times in yours. It is said once, and again after a compaction or when a date or the offset changes. Used only while `#agentPlus.tokenMode#` is Custom."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "opencodePlus.chat",
        "displayName": "OpenCode Plus Conversation",
        "selector": [
          {
            "filenamePattern": "*.opencodeplus-chat"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsWelcome": [
      {
        "view": "opencodePlus.sessions",
        "contents": "No conversations yet.\n[New Conversation](command:opencodePlus.newConversation)"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xnervwang/vscode-opencode-plus"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  }
}
