{
  "name": "new-agent",
  "displayName": "New Agent",
  "description": "A coding agent for models on Amazon Bedrock, with work plans and conversation overviews.",
  "version": "0.0.1",
  "publisher": "xnervwang",
  "icon": "images/icon.png",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "xnervwang.agent-plus"
  ],
  "agentPlus": {
    "protocol": 1
  },
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:newAgent.chat",
    "onView:newAgent.sessions"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the agent cannot read or change files or run commands."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "newAgent",
          "title": "New Agent",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "newAgent": [
        {
          "id": "newAgent.sessions",
          "name": "Conversations"
        }
      ]
    },
    "commands": [
      {
        "command": "newAgent.newConversation",
        "title": "New Conversation",
        "category": "New Agent",
        "icon": "$(add)"
      },
      {
        "command": "newAgent.openConversation",
        "title": "Open Conversation",
        "category": "New Agent"
      },
      {
        "command": "newAgent.renameConversation",
        "title": "Rename Conversation",
        "category": "New Agent",
        "icon": "$(edit)"
      },
      {
        "command": "newAgent.deleteConversation",
        "title": "Delete Conversation",
        "category": "New Agent",
        "icon": "$(trash)"
      },
      {
        "command": "newAgent.chooseModel",
        "title": "Choose Model for New Conversations",
        "category": "New Agent"
      },
      {
        "command": "newAgent.testConnection",
        "title": "Test OpenCode Connection",
        "category": "New Agent"
      },
      {
        "command": "newAgent.setBedrockApiKey",
        "title": "Set Amazon Bedrock API Key",
        "category": "New Agent"
      },
      {
        "command": "newAgent.clearBedrockApiKey",
        "title": "Clear Amazon Bedrock API Key",
        "category": "New Agent"
      },
      {
        "command": "newAgent.downloadPython",
        "title": "Download Python for Work Plans",
        "category": "New Agent"
      },
      {
        "command": "newAgent.findPython",
        "title": "Look for Python Again for Work Plans",
        "category": "New Agent"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "newAgent.newConversation",
          "when": "view == newAgent.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "newAgent.deleteConversation",
          "when": "view == newAgent.sessions && viewItem == newAgent.session",
          "group": "9_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "newAgent.openConversation",
          "when": "false"
        },
        {
          "command": "newAgent.renameConversation",
          "when": "false"
        },
        {
          "command": "newAgent.deleteConversation",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "New Agent",
      "properties": {
        "newAgent.model": {
          "type": "string",
          "default": "",
          "description": "Model for new conversations, as provider/model, such as amazon-bedrock/us.xai.grok-4.7. Empty asks before the first message."
        },
        "newAgent.opencode.path": {
          "type": "string",
          "default": "",
          "description": "Path to the opencode executable. Empty looks for it on PATH and where its installers put it."
        },
        "newAgent.opencode.askPermissions": {
          "type": "boolean",
          "default": true,
          "description": "Ask before OpenCode edits files, runs commands, fetches web pages or reads outside the project. This replaces the edit, bash, webfetch and external_directory rules of your own OpenCode configuration; turn it off to keep those."
        },
        "newAgent.bedrock.profile": {
          "type": "string",
          "default": "",
          "description": "AWS profile for Amazon Bedrock, given to OpenCode as AWS_PROFILE. Empty leaves it to OpenCode and your AWS configuration."
        },
        "newAgent.bedrock.region": {
          "type": "string",
          "default": "",
          "description": "AWS Region for Amazon Bedrock, given to OpenCode as AWS_REGION. Empty leaves it to OpenCode and your AWS configuration."
        },
        "newAgent.workPlan": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Keep a work plan in each conversation on OpenCode 2: the plan goes with every message, and the model gets tools to change it. Used only while `#agentPlus.tokenMode#` is Custom."
        },
        "newAgent.conversationBrief": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Have the model keep a short summary and status of each conversation in its plan, shown by Agent Plus when the conversation is clicked. Used only while `#agentPlus.tokenMode#` is Custom."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "newAgent.chat",
        "displayName": "New Agent Conversation",
        "selector": [
          {
            "filenamePattern": "*.newagent-chat"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsWelcome": [
      {
        "view": "newAgent.sessions",
        "contents": "No conversations yet.\n[New Conversation](command:newAgent.newConversation)"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xnervwang/vscode-new-agent"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  }
}
